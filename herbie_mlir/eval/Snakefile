import os
import glob
import subprocess
import platform
import datetime
from pathlib import Path

# ---------------------------------------------------------------------------
# Resolve the two inputs the pipeline needs from outside this directory:
# the compiler (herbie-mlir-opt) and the Racket prefix Herbie is installed into.
#
# Usage: snakemake --config build_dir=... [racket_prefix=...]
#
# They are separate config keys because they do not always come from the same
# place. An in-tree CMake build configured with -DHERBIE_MLIR_BUILD_HERBIE=ON
# produces both under one build directory, so `racket_prefix` can be left
# unset. Under Nix they are two independent store paths (`nix run
# .#herbie-eval` passes both), because a Racket prefix built by cloning Herbie
# and resolving packages from the catalog cannot be produced inside the
# network-less build sandbox -- it is its own derivation with pinned sources.
# ---------------------------------------------------------------------------
EVAL_DIR   = Path(workflow.basedir).resolve()
REPO_ROOT  = EVAL_DIR.parents[1]

def _resolve_dir(value):
    """Interpret a config path relative to the repo root, as an absolute Path."""
    path = Path(value)
    return path if path.is_absolute() else (REPO_ROOT / path).resolve()

BUILD_DIR = _resolve_dir(config.get("build_dir", "build-eval"))

# Defaults to where the CMake build puts it (HERBIE_RACKET_PREFIX in
# herbie_mlir/CMakeLists.txt), so a plain source build needs only build_dir.
RACKET_PREFIX = _resolve_dir(
    config.get("racket_prefix", BUILD_DIR / "herbie_mlir" / "racket-pkgs")
)

herbie_mlir_opt_path = str(BUILD_DIR / "bin" / "herbie-mlir-opt")
herbie_racket_prefix = str(RACKET_PREFIX)

# ---------------------------------------------------------------------------
# Evaluation parameters. Single source of truth: used in the rules *and*
# recorded in the provenance manifest, and overridable for sensitivity runs
# (e.g. `snakemake --config seed=7 max_nodes=8000`).
# ---------------------------------------------------------------------------
SEED             = int(config.get("seed", 42))
MAX_SAT_ITERS    = int(config.get("max_saturation_iters", 20))
MAX_NODES        = int(config.get("max_nodes", 4000))
HERBIE_NUM_ITERS = int(config.get("herbie_num_iters", 1))

# Get all benchmark names from fpcore files (sorted for reproducibility)
benchmark_names = sorted([
    os.path.splitext(os.path.basename(f))[0]
    for f in glob.glob("fpcore/*.fpcore")
])

# ---------------------------------------------------------------------------
# Output layout. Results go to a directory at the top level of the repository
# (not under herbie_mlir/eval), overridable with `--config out_dir=...`; a
# relative value is taken relative to the repo root.
#
# Every generated directory and file carries a two-digit stage prefix, so a
# plain `ls` of the output tree reads in pipeline order rather than
# alphabetically. Keep the numbers in step with the rule order below.
# ---------------------------------------------------------------------------
OUT_DIR = str(_resolve_dir(config.get("out_dir", "eval-out")))

RULES_DIR             = f"{OUT_DIR}/01-rules"
MLIR_DIR              = f"{OUT_DIR}/02-mlir"
OPTIMIZED_DIR         = f"{OUT_DIR}/03-optimized"
OPTIMIZE_TIMING_DIR   = f"{OUT_DIR}/04-optimize_timing"
SATURATION_TIMING_DIR = f"{OUT_DIR}/05-saturation_timing"
OPTIMIZED_FPCORE_DIR  = f"{OUT_DIR}/06-optimized_fpcore"
FPCORE_MERGED_DIR     = f"{OUT_DIR}/07-fpcore_merged"
HERBIE_INPUT          = f"{OUT_DIR}/08-herbie_input.fpcore"
HERBIE_EVAL_DIR       = f"{OUT_DIR}/09-herbie_eval"
EVALUATION_CSV        = f"{OUT_DIR}/10-evaluation.csv"
PLOTS_DIR             = f"{OUT_DIR}/11-plots"
PROVENANCE            = f"{OUT_DIR}/12-provenance.txt"
PAPER_NAME            = "13-paper-artifact"
PAPER_DIR             = f"{OUT_DIR}/{PAPER_NAME}"
PAPER_TARBALL         = f"{OUT_DIR}/{PAPER_NAME}.tar.gz"

PLOTS = [
    f"{PLOTS_DIR}/1-accuracy_comparison.pdf",
    f"{PLOTS_DIR}/2-accuracy_comparison_compact.pdf",
    f"{PLOTS_DIR}/3-timing_comparison.pdf",
    f"{PLOTS_DIR}/4-timing_comparison_no_pdl.pdf",
    f"{PLOTS_DIR}/5-matcher_speedup.pdf",
]

# Cheap, non-measuring rules: never worth scheduling as separate cluster jobs.
localrules: all, paper, provenance, clean, concatenate_merged_fpcores

rule all:
    input:
        PLOTS,

# ============ Rules Processing Pipeline ============

rule convert_rules_to_pdl:
    output:
        f"{RULES_DIR}/rules_pdl.mlir"
    shell:
        "herbie-pdl ../rules.rkt > {output}"

rule convert_pdl_to_pdl_interp:
    input:
        f"{RULES_DIR}/rules_pdl.mlir"
    output:
        f"{RULES_DIR}/rules_pdl_interp.mlir"
    shell:
        "xdsl-opt -p 'convert-pdl-to-pdl-interp{{optimize_for_eqsat=true}}' {input} -o {output}"

rule convert_pdl_to_pdl_interp_individual:
    input:
        f"{RULES_DIR}/rules_pdl.mlir"
    output:
        f"{RULES_DIR}/rules_pdl_interp_individual.mlir"
    shell:
        "xdsl-opt -p 'convert-pdl-to-pdl-interp{{optimize_for_eqsat=true convert-individually=true}}' {input} -o {output}"

# ============ Benchmark Processing Pipeline ============

rule fpcore_to_mlir:
    input:
        "fpcore/{benchmark}.fpcore"
    output:
        f"{MLIR_DIR}/{{benchmark}}.mlir"
    shell:
        "fpcore-mlir {input} > {output}"

# Produces the optimized MLIR *and* its wall-clock measurement. bench=1 keeps
# it from running concurrently with any other measured rule (see note below).
rule optimize:
    input:
        mlir = f"{MLIR_DIR}/{{benchmark}}.mlir",
        pdl_interp = f"{RULES_DIR}/rules_pdl_interp.mlir"
    output:
        mlir = f"{OPTIMIZED_DIR}/{{benchmark}}.mlir",
        timing = f"{OPTIMIZE_TIMING_DIR}/{{benchmark}}.json"
    resources:
        bench = 1
    shell:
        '{herbie_mlir_opt_path} -herbie-optimize="max-saturation-iters={MAX_SAT_ITERS} max-nodes={MAX_NODES} patterns-file={input.pdl_interp}" --remove-dead-values {input.mlir} -tamagoyaki-timing -tamagoyaki-timing-output=json 2> {output.timing} > {output.mlir}'

# ============ Saturation Timing Pipeline ============

rule saturation_timing_joint:
    input:
        mlir = f"{MLIR_DIR}/{{benchmark}}.mlir",
        pdl_interp = f"{RULES_DIR}/rules_pdl_interp.mlir"
    output:
        f"{SATURATION_TIMING_DIR}/{{benchmark}}_joint.json"
    resources:
        bench = 1
    shell:
        '{herbie_mlir_opt_path} -equivalence-insert-graph -ematch-saturate="patterns-file={input.pdl_interp} max-iters={MAX_SAT_ITERS} max-nodes={MAX_NODES} eager-rewrite=false" {input.mlir} -tamagoyaki-timing -tamagoyaki-timing-output=json 2> {output} > /dev/null'

rule saturation_timing_individual:
    input:
        mlir = f"{MLIR_DIR}/{{benchmark}}.mlir",
        pdl_interp = f"{RULES_DIR}/rules_pdl_interp_individual.mlir"
    output:
        f"{SATURATION_TIMING_DIR}/{{benchmark}}_individual.json"
    resources:
        bench = 1
    shell:
        '{herbie_mlir_opt_path} -equivalence-insert-graph -ematch-saturate="patterns-file={input.pdl_interp} max-iters={MAX_SAT_ITERS} max-nodes={MAX_NODES} eager-rewrite=false" {input.mlir} -tamagoyaki-timing -tamagoyaki-timing-output=json 2> {output} > /dev/null'

rule optimized_mlir_to_fpcore:
    input:
        f"{OPTIMIZED_DIR}/{{benchmark}}.mlir"
    output:
        f"{OPTIMIZED_FPCORE_DIR}/{{benchmark}}.fpcore"
    shell:
        "mlir-fpcore {input} > {output}"

# ============ FPCore Merging Pipeline ============

rule insert_fpcore_alternatives:
    input:
        original = "fpcore/{benchmark}.fpcore",
        optimized = f"{OPTIMIZED_FPCORE_DIR}/{{benchmark}}.fpcore"
    output:
        f"{FPCORE_MERGED_DIR}/{{benchmark}}.fpcore"
    shell:
        "insert-fpcore-alternative {input.original} {input.optimized} > {output}"

rule concatenate_merged_fpcores:
    input:
        expand(f"{FPCORE_MERGED_DIR}/{{benchmark}}.fpcore", benchmark=benchmark_names)
    output:
        HERBIE_INPUT
    shell:
        "cat {input} > {output}"

# ============ Herbie Evaluation Pipeline ============

# Accuracy, not timing — but it is CPU-heavy, so it also takes bench=1 to keep
# it from stealing cores from a concurrently-running measured rule.
rule run_herbie_report:
    input:
        HERBIE_INPUT
    output:
        directory(f"{HERBIE_EVAL_DIR}/herbie_report")
    resources:
        bench = 1
    shell:
        'PLTADDONDIR={herbie_racket_prefix} racket -l herbie report --disable setup:preprocess --disable reduce:regimes --disable generate:taylor --disable generate:proofs  --platform math --num-iters {HERBIE_NUM_ITERS} --seed {SEED} --threads 1 {input} {output}'

# ============ Evaluation Export Pipeline ============

rule extract_evaluation_csv:
    input:
        report = f"{HERBIE_EVAL_DIR}/herbie_report",
        optimize_timing = expand(f"{OPTIMIZE_TIMING_DIR}/{{benchmark}}.json", benchmark=benchmark_names),
        timing_joint = expand(f"{SATURATION_TIMING_DIR}/{{benchmark}}_joint.json", benchmark=benchmark_names),
        timing_individual = expand(f"{SATURATION_TIMING_DIR}/{{benchmark}}_individual.json", benchmark=benchmark_names),
    output:
        EVALUATION_CSV
    shell:
        "extract-accuracies {input.report}/results.json {OPTIMIZE_TIMING_DIR} {SATURATION_TIMING_DIR} > {output}"

# ============ Plotting Pipeline ============

rule generate_accuracy_plot:
    input:
        EVALUATION_CSV
    output:
        PLOTS[0]
    shell:
        "plot-accuracies {input} -o {output}"

rule generate_accuracy_plot_compact:
    input:
        EVALUATION_CSV
    output:
        PLOTS[1]
    shell:
        "plot-accuracies {input} -o {output} --compact"

rule generate_matcher_speedup_plot:
    input:
        EVALUATION_CSV
    output:
        PLOTS[4]
    shell:
        "plot-matcher-speedup {input} -o {output}"

rule generate_timing_plot:
    input:
        EVALUATION_CSV
    output:
        PLOTS[2]
    shell:
        "plot-timing {input} -o {output}"

rule generate_timing_plot_no_pdl:
    input:
        EVALUATION_CSV
    output:
        PLOTS[3]
    shell:
        "plot-timing {input} -o {output} --no-pdl-loading"

# ============ Provenance + Paper Artifact ============

# Records the environment behind a run so a figure can always be traced back to
# a commit, a toolchain and a parameter set. Depends on evaluation.csv so it is
# regenerated whenever the data is; delete out/provenance.txt to force a fresh
# capture without recomputing.
rule provenance:
    input:
        csv = EVALUATION_CSV,
    output:
        PROVENANCE,
    run:
        def cmd(args):
            try:
                r = subprocess.run(args, capture_output=True, text=True)
                return (r.stdout or r.stderr).strip().splitlines()[0] if (r.stdout or r.stderr) else ""
            except Exception as e:
                return f"<unavailable: {e}>"

        def cpu_model():
            try:
                for line in open("/proc/cpuinfo"):
                    if line.startswith("model name"):
                        return line.split(":", 1)[1].strip()
            except Exception:
                pass
            return cmd(["sysctl", "-n", "machdep.cpu.brand_string"]) or "<unknown>"

        git_rev = cmd(["git", "-C", str(REPO_ROOT), "rev-parse", "HEAD"])
        dirty = cmd(["git", "-C", str(REPO_ROOT), "status", "--porcelain"])

        lines = [
            "# Tamagoyaki / Herbie-MLIR evaluation provenance",
            f"generated_utc:        {datetime.datetime.now(datetime.timezone.utc).isoformat()}",
            f"git_rev:              {git_rev}{'  (DIRTY WORKING TREE)' if dirty else ''}",
            f"host:                 {platform.node()}",
            f"platform:             {platform.platform()}",
            f"cpu:                  {cpu_model()}  x{os.cpu_count()}",
            f"python:               {platform.python_version()}",
            f"snakemake:            {cmd(['snakemake', '--version'])}",
            f"racket:               {cmd(['racket', '--version'])}",
            f"herbie_mlir_opt:      {herbie_mlir_opt_path}",
            f"herbie_mlir_opt_ver:  {cmd([herbie_mlir_opt_path, '--version'])}",
            f"build_dir:            {BUILD_DIR}",
            f"racket_prefix:        {RACKET_PREFIX}",
            f"out_dir:              {OUT_DIR}",
            f"herbie:               {cmd(['env', f'PLTADDONDIR={herbie_racket_prefix}', 'racket', '-l', 'herbie', '--', '--version'])}",
            f"benchmarks:           {len(benchmark_names)}",
            "",
            "[parameters]",
            f"seed:                 {SEED}",
            f"max_saturation_iters: {MAX_SAT_ITERS}",
            f"max_nodes:            {MAX_NODES}",
            f"herbie_num_iters:     {HERBIE_NUM_ITERS}",
            "",
        ]
        with open(output[0], "w") as fh:
            fh.write("\n".join(lines))
        print("\n".join(lines))

# Everything a reviewer needs in one directory: the five figures, the raw CSV
# and the manifest. `snakemake paper` builds it; the tarball is one file to ship.
rule paper:
    input:
        plots = PLOTS,
        csv = EVALUATION_CSV,
        provenance = PROVENANCE,
    output:
        directory(PAPER_DIR),
    shell:
        r"""
        mkdir -p {output}/plots
        cp {input.csv} {input.provenance} {output}/
        cp {input.plots} {output}/plots/
        ( cd {OUT_DIR} && tar -czf {PAPER_NAME}.tar.gz {PAPER_NAME} )
        """

# ============ Utility Rules ============

rule clean:
    shell:
        f"rm -rf {OUT_DIR}"
