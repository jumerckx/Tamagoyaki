# TamagoyakiConfig.cmake - package config for find_package(Tamagoyaki CONFIG)
#
# Provides the imported targets MLIREquivalence, MLIREmatch and
# TamagoyakiTiming, and the add_dialect_tablegen() helper that generates a
# dialect's .inc files. Target names are unprefixed to match MLIR's own
# convention (MLIRIR, MLIROptLib, ...), so a link list reads the same whether
# Tamagoyaki was found with this file or pulled in with add_subdirectory().
#
# Tamagoyaki_DIR may point either at an install prefix's
# lib/cmake/tamagoyaki, or -- for the development loop, with nothing
# installed -- at a build directory's lib/cmake/tamagoyaki.
#
# Variables set:
#   TAMAGOYAKI_TOOLS_DIR      where tamagoyaki-opt lives (run, not linked)
#   TAMAGOYAKI_CMAKE_DIR      this directory
#   TAMAGOYAKI_ENABLE_HIGHS   whether the ILP selection pass has its solver
#
# The MLIR and HiGHS locations Tamagoyaki was configured against are baked in
# as fallbacks below. Under Nix those are immutable store paths and are exactly
# right; elsewhere they are only a default, overridden by setting MLIR_DIR or
# highs_DIR before find_package(Tamagoyaki).

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(TAMAGOYAKI_ENABLE_HIGHS @TAMAGOYAKI_ENABLE_HIGHS@)

# The exported targets name MLIR's own (MLIRIR, MLIRRegisterAllDialects, ...),
# so MLIR has to resolve before the target file is read. A consumer that has
# already called find_package(MLIR), or passed MLIR_DIR, keeps its own choice;
# otherwise it gets the one Tamagoyaki was compiled against, which is the only
# one its libraries are ABI-compatible with anyway.
if(NOT MLIR_DIR)
  set(MLIR_DIR "@MLIR_DIR@")
endif()
find_dependency(MLIR)

if(TAMAGOYAKI_ENABLE_HIGHS)
  # MLIREquivalence links highs::highs PRIVATE. For a static library that
  # still lands in the export as $<LINK_ONLY:highs::highs>, so the imported
  # target has to exist even though no consumer ever names it -- which would
  # otherwise make a consumer hunt down a dependency it does not know it has.
  if(NOT highs_DIR)
    set(highs_DIR "@highs_DIR@")
  endif()
  find_dependency(highs)
endif()

set_and_check(TAMAGOYAKI_TOOLS_DIR "@PACKAGE_TAMAGOYAKI_CONFIG_TOOLSDIR@")
set_and_check(TAMAGOYAKI_CMAKE_DIR "@PACKAGE_TAMAGOYAKI_CONFIG_CMAKEDIR@")

# add_dialect_tablegen(). Part of the published interface: a downstream dialect
# generates its .inc files exactly the way include/CMakeLists.txt does.
include("${TAMAGOYAKI_CMAKE_DIR}/TableGenHelpers.cmake")

include("${CMAKE_CURRENT_LIST_DIR}/TamagoyakiTargets.cmake")

check_required_components(Tamagoyaki)
