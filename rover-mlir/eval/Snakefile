import os
import re
import shutil
import sys
from pathlib import Path

# ---------------------------------------------------------------------------
# The Rover datapath evaluation: four configurations of the same four circuits,
# each synthesized through the same backend, compared on ASAP7-mapped area and
# delay plus the wall clock the e-graph cost.
#
#   baseline       circt-synth on the input as written -- no e-graph at all.
#   rover          saturate with the base rewrite set (comb/hw only), extract.
#   multi          saturate with base + datapath rewrites, extract.
#   multi-persist  as multi, but run CIRCT's --canonicalize and
#                  --comb-int-range-narrowing over the *persisted e-graph*
#                  before extracting from it.
#
# Usage: snakemake --config build_dir=... [out_dir=...] [genlib=...]
# `nix run .#rover-eval` fills in build_dir, circt_bin and abc from the store.
# ---------------------------------------------------------------------------
EVAL_DIR  = Path(workflow.basedir).resolve()
REPO_ROOT = EVAL_DIR.parents[1]
RULES_SRC = REPO_ROOT / "rover-mlir" / "rules"

# The shared evaluation code comes from the checkout, not from wherever
# tamagoyaki_eval is installed -- see tamagoyaki_eval/__init__.py for why.
sys.path.insert(0, str(REPO_ROOT))

from tamagoyaki_eval import dir_resolver, provenance

_resolve_dir = dir_resolver(REPO_ROOT)

BUILD_DIR = _resolve_dir(config.get("build_dir", "build-eval-rover"))
rover_opt = str(BUILD_DIR / "bin" / "rover-mlir-opt")

# CIRCT and ABC come from the Nix store under `nix run`, from PATH otherwise.
CIRCT_BIN = config.get("circt_bin", "")
def _circt(name):
    return str(Path(CIRCT_BIN) / name) if CIRCT_BIN else name

circt_synth     = _circt("circt-synth")
circt_translate = _circt("circt-translate")
abc             = config.get("abc", "abc")

# The vendored ASAP7 library; see lib/README.md for provenance.
GENLIB = str(_resolve_dir(config.get("genlib", EVAL_DIR / "lib" / "asap7.genlib")))

# ---------------------------------------------------------------------------
# Evaluation parameters. Single source of truth: used in the rules *and*
# recorded in the provenance manifest, and overridable for sensitivity runs
# (e.g. `EXTRA_CONFIG='max_iters=8' rover-eval`).
# ---------------------------------------------------------------------------
MAX_ITERS = int(config.get("max_iters", 4))
MAX_NODES = int(config.get("max_nodes", 0))

# How many times each measured command is re-run.
REPS = int(config.get("reps", 100))

# Which CPU the measured jobs are pinned to. "auto" (the default) picks one;
# a number pins there; "none" runs unpinned.
def _resolve_pin(value):
    if value is None or value is False:
        return None
    if isinstance(value, str) and value.strip().lower() in ("", "none", "off"):
        return None
    # taskset is util-linux; elsewhere there is nothing to pin with.
    if not shutil.which("taskset"):
        return None
    if not (isinstance(value, str) and value.strip().lower() == "auto"):
        return int(value)
    try:
        allowed = os.sched_getaffinity(0)
    except AttributeError:  # not Linux
        return None
    return max(allowed)

PIN_CPU = _resolve_pin(config.get("pin_cpu", "auto"))
MEASURE = f"taskset -c {PIN_CPU} " if PIN_CPU is not None else ""

# circt-synth knobs. The defaults reproduce the plain `circt-synth in -o out`
# invocation the original automate_pipeline.py used, so the numbers stay
# comparable; synth_until can stop the pipeline early (e.g. "mapping" to hand
# ABC a pre-mapping AIG).
SYNTH_STRATEGY = config.get("synthesis_strategy", "")
SYNTH_UNTIL    = config.get("synth_until", "")
SYNTH_FLAGS    = " ".join(filter(None, [
    f"--synthesis-strategy={SYNTH_STRATEGY}" if SYNTH_STRATEGY else "",
    f"--until-before={SYNTH_UNTIL}" if SYNTH_UNTIL else "",
]))

# Configurations, and which rule set each saturates with. Keep in step with
# CONFIGS in tamagoyaki_eval/rover/latex_table.py, which owns the column order.
CONFIGS = ["baseline", "rover", "multi", "multi-persist"]
RULESET = {"rover": "base", "multi": "full", "multi-persist": "full"}

BENCHMARKS = sorted(p.stem for p in (EVAL_DIR / "benchmarks").glob("*.mlir"))

# `multi-persist` contains a hyphen and the intermediate files carry .sat/.canon
# infixes, so without these Snakemake mis-splits paths like
# 05-timing/multi-persist/MulSel.canon.json.
wildcard_constraints:
    config = "|".join(re.escape(c) for c in CONFIGS),
    bench  = "|".join(re.escape(b) for b in BENCHMARKS),
    set    = "base|full",
    rep    = r"\d+",

# ---------------------------------------------------------------------------
# Output layout. Results go to a directory at the top level of the repository
# (not under rover-mlir/eval), overridable with `--config out_dir=...`; a
# relative value is taken relative to the repo root.
#
# Every generated directory and file carries a two-digit stage prefix, so a
# plain `ls` of the output tree reads in pipeline order rather than
# alphabetically. Keep the numbers in step with the rule order below.
# ---------------------------------------------------------------------------
OUT_DIR = str(_resolve_dir(config.get("out_dir", "rover-eval-out")))

RULES_DIR     = f"{OUT_DIR}/01-rules"
INPUT_DIR     = f"{OUT_DIR}/02-input"
EGRAPH_DIR    = f"{OUT_DIR}/03-egraph"
EXTRACTED_DIR = f"{OUT_DIR}/04-extracted"
TIMING_DIR    = f"{OUT_DIR}/05-timing"
SYNTH_DIR     = f"{OUT_DIR}/06-synth"
AIGER_DIR     = f"{OUT_DIR}/07-aiger"
ABC_DIR       = f"{OUT_DIR}/08-abc"
RESULTS_CSV   = f"{OUT_DIR}/09-results.csv"
TABLE_TEX     = f"{OUT_DIR}/10-table.tex"
EGRAPH_CSV    = f"{OUT_DIR}/11-egraph.csv"
EGRAPH_TEX    = f"{OUT_DIR}/12-egraph-table.tex"
PROVENANCE    = f"{OUT_DIR}/13-provenance.txt"
PAPER_NAME    = "14-paper-artifact"
PAPER_DIR     = f"{OUT_DIR}/{PAPER_NAME}"
PAPER_TARBALL = f"{OUT_DIR}/{PAPER_NAME}.tar.gz"

# Cheap, non-measuring rules: never worth scheduling as separate cluster jobs.
localrules: all, provenance, copy_input, baseline_passthrough, \
            rules_base_pdl, rules_full_pdl, results_csv, latex_table, \
            egraph_csv, egraph_table

rule all:
    input:
        TABLE_TEX,
        EGRAPH_TEX,
        PROVENANCE,

# ---------------------------------------------------------------------------
# 01 -- rule sets
#
# The two PDL sources concatenate directly: the patterns sit at the top level
# of each file (implicit module), so `cat` is a valid pattern set. The matchers
# themselves come from the shared pdl_to_pdl_interp rule below; regenerating
# them per run is what keeps the evaluation independent of the checked-in
# rover-mlir/rules/rewrites_pdl_interp.mlir, which only the lit tests read.
# ---------------------------------------------------------------------------
rule rules_base_pdl:
    input:
        RULES_SRC / "rewrites_base.mlir"
    output:
        f"{RULES_DIR}/base_pdl.mlir"
    shell:
        "cp {input} {output}"

rule rules_full_pdl:
    input:
        base = RULES_SRC / "rewrites_base.mlir",
        datapath = RULES_SRC / "rewrites_datapath.mlir"
    output:
        f"{RULES_DIR}/full_pdl.mlir"
    shell:
        "cat {input.base} {input.datapath} > {output}"

# ---------------------------------------------------------------------------
# 02 -- inputs
#
# Plain hw.module, no equivalence.graph: the baseline needs un-wrapped IR, and
# the rover configurations get the wrapper from --rover-insert-graph. The lit
# suite drives these same files (rover-mlir/test/benchmarks).
# ---------------------------------------------------------------------------
rule copy_input:
    input:
        EVAL_DIR / "benchmarks" / "{bench}.mlir"
    output:
        f"{INPUT_DIR}/{{bench}}.mlir"
    shell:
        "cp {input} {output}"

# ---------------------------------------------------------------------------
# 03/04/05 -- e-graph configurations
#
# The rules in this section come in pairs: one that produces IR the rest of the
# pipeline consumes, and one that measures the same command REPS times and
# keeps only the timing report. They are kept apart deliberately --
#
#   * the measured command is then byte-identical across every repetition, and
#     does not also pay for writing out the IR that the artifact rule writes;
#   * REPS does not multiply the synthesis work, which is deterministic and
#     would only burn wall clock;
#   * a rerun of the timing never invalidates the area/delay numbers.
#
# On timing: `-tamagoyaki-timing` and `-mlir-timing` both write JSON to stderr,
# so enabling both in one process concatenates two documents into something
# unparseable. Only one timing writer per invocation -- which is why
# multi-persist below is three processes rather than one pipeline.
#
# On resolution: `-tamagoyaki-timing` prints nanoseconds (see the
# HighPrecisionJsonStrategy in src/TamagoyakiTiming.cpp for why it has to).
# `-mlir-timing` is MlirOptMain's own timing manager, which this tool cannot
# substitute an output strategy into, so the CIRCT-pass durations in
# *.canon.json are still MLIR's stock `%8.4f` seconds, i.e. rounded to 0.1 ms.
# Repetitions are what makes those numbers usable until that is fixed.
# ---------------------------------------------------------------------------
# The saturation itself: identical for both rule sets, so the rules below differ
# only in which matcher they load and where their output goes.
SATURATE = (
    '{rover_opt} --rover-insert-graph {input.mlir}'
    ' --rover-saturate="patterns-file={input.rules}'
    ' max-iters={MAX_ITERS} max-nodes={MAX_NODES}"'
)

rule baseline_passthrough:
    input:
        f"{INPUT_DIR}/{{bench}}.mlir"
    output:
        f"{EXTRACTED_DIR}/baseline/{{bench}}.mlir"
    shell:
        "cp {input} {output}"

SATURATE_EXTRACT = (
    SATURATE + ' --rover-extract=delay --remove-dead-values'
)

rule saturate_extract:
    input:
        mlir = f"{INPUT_DIR}/{{bench}}.mlir",
        rules = lambda w: f"{RULES_DIR}/{RULESET[w.config]}_pdl_interp.mlir"
    output:
        f"{EXTRACTED_DIR}/{{config}}/{{bench}}.mlir"
    wildcard_constraints:
        config = "rover|multi"
    resources:
        bench = 1
    shell:
        SATURATE_EXTRACT + ' > {output}'

rule measure_saturate_extract:
    input:
        mlir = f"{INPUT_DIR}/{{bench}}.mlir",
        rules = lambda w: f"{RULES_DIR}/{RULESET[w.config]}_pdl_interp.mlir"
    output:
        f"{TIMING_DIR}/{{config}}/{{bench}}.r{{rep}}.json"
    wildcard_constraints:
        config = "rover|multi"
    resources:
        bench = 1
    shell:
        MEASURE + SATURATE_EXTRACT +
        ' -tamagoyaki-timing -tamagoyaki-timing-output=json'
        ' 2> {output} > /dev/null'

rule persist_saturate:
    input:
        mlir = f"{INPUT_DIR}/{{bench}}.mlir",
        rules = f"{RULES_DIR}/full_pdl_interp.mlir"
    output:
        f"{EGRAPH_DIR}/{{bench}}.full-sat.mlir"
    resources:
        bench = 1
    shell:
        SATURATE + ' > {output}'

rule measure_persist_saturate:
    input:
        mlir = f"{INPUT_DIR}/{{bench}}.mlir",
        rules = f"{RULES_DIR}/full_pdl_interp.mlir"
    output:
        f"{TIMING_DIR}/multi-persist/{{bench}}.r{{rep}}.json"
    resources:
        bench = 1
    shell:
        MEASURE + SATURATE +
        ' -tamagoyaki-timing -tamagoyaki-timing-output=json'
        ' 2> {output} > /dev/null'

# The e-graph size table needs a single-level graph to compare against, and the
# `rover` configuration saturates and extracts in one process, so its graph is
# never written out. Saturate once more with the base rule set purely to have
# one on disk: nothing is timed here, and the numbers in the results table still
# come from saturate_extract.
rule saturate_base_egraph:
    input:
        mlir = f"{INPUT_DIR}/{{bench}}.mlir",
        rules = f"{RULES_DIR}/base_pdl_interp.mlir"
    output:
        f"{EGRAPH_DIR}/{{bench}}.base-sat.mlir"
    resources:
        bench = 1
    shell:
        SATURATE + ' > {output}'

# CIRCT passes over the persisted e-graph. Run in rover-mlir-opt, not circt-opt:
# circt-opt does not know the equivalence dialect and cannot parse the graph.
CIRCT_PASSES = '{rover_opt} {input} --canonicalize --comb-int-range-narrowing'

rule persist_canonicalize:
    input:
        f"{EGRAPH_DIR}/{{bench}}.full-sat.mlir"
    output:
        f"{EGRAPH_DIR}/{{bench}}.canon.mlir"
    resources:
        bench = 1
    shell:
        CIRCT_PASSES + ' -o {output}'

rule measure_persist_canonicalize:
    input:
        f"{EGRAPH_DIR}/{{bench}}.full-sat.mlir"
    output:
        f"{TIMING_DIR}/multi-persist/{{bench}}.canon.r{{rep}}.json"
    resources:
        bench = 1
    shell:
        MEASURE + CIRCT_PASSES +
        ' -mlir-timing -mlir-timing-display=tree -mlir-output-format=json'
        ' 2> {output} > /dev/null'

# The size of each persisted graph, as the compiler itself counts it: the
# analysis behind --equivalence-graph-size is the one the saturation loop prints
# under --debug-only=ematch, so the numbers do not depend on an assertions
# build. It has to run here rather than during saturation anyway, because the
# `multi-persist` graph is only complete after the CIRCT passes above.
rule egraph_size:
    input:
        f"{EGRAPH_DIR}/{{bench}}.{{variant}}.mlir"
    output:
        f"{EGRAPH_DIR}/{{bench}}.{{variant}}.size.txt"
    wildcard_constraints:
        variant = "base-sat|full-sat|canon",
    shell:
        "{rover_opt} --equivalence-graph-size {input} -o /dev/null > {output}"

rule persist_extract:
    input:
        f"{EGRAPH_DIR}/{{bench}}.canon.mlir"
    output:
        f"{EXTRACTED_DIR}/multi-persist/{{bench}}.mlir"
    resources:
        bench = 1
    shell:
        '{rover_opt} {input} --rover-extract=delay --remove-dead-values -o {output}'

# ---------------------------------------------------------------------------
# 06/07/08 -- the shared synthesis backend
#
# Identical for all four configurations; only the input IR differs. circt-synth
# lowers comb to AIG (including any datapath ops rover produced -- it runs
# ConvertDatapathToComb itself), circt-translate exports AIGER, and ABC does the
# ASAP7 technology mapping the reported numbers come from. The ABC command is
# kept byte-identical to the original automate_pipeline.py.
# ---------------------------------------------------------------------------
rule synth:
    input:
        f"{EXTRACTED_DIR}/{{config}}/{{bench}}.mlir"
    output:
        f"{SYNTH_DIR}/{{config}}/{{bench}}.mlir"
    resources:
        bench = 1
    shell:
        "{circt_synth} {input} -o {output} --abc-path={abc} {SYNTH_FLAGS}"

rule export_aiger:
    input:
        f"{SYNTH_DIR}/{{config}}/{{bench}}.mlir"
    output:
        f"{AIGER_DIR}/{{config}}/{{bench}}.aig"
    shell:
        "{circt_translate} --export-aiger {input} -o {output}"

rule abc_map:
    input:
        f"{AIGER_DIR}/{{config}}/{{bench}}.aig"
    output:
        f"{ABC_DIR}/{{config}}/{{bench}}.txt"
    shell:
        '{abc} -c "read_genlib {GENLIB}; read {input}; strash; map; print_stats" > {output}'

# ---------------------------------------------------------------------------
# 09..13 -- results
# ---------------------------------------------------------------------------
rule results_csv:
    input:
        abc = expand(f"{ABC_DIR}/{{config}}/{{bench}}.txt",
                     config=CONFIGS, bench=BENCHMARKS),
        timing = expand(f"{TIMING_DIR}/{{config}}/{{bench}}.r{{rep}}.json",
                        config=[c for c in CONFIGS if c != "baseline"],
                        bench=BENCHMARKS, rep=range(REPS)),
        canon = expand(f"{TIMING_DIR}/multi-persist/{{bench}}.canon.r{{rep}}.json",
                       bench=BENCHMARKS, rep=range(REPS)),
    output:
        RESULTS_CSV
    params:
        configs = " ".join(CONFIGS),
        benchmarks = " ".join(BENCHMARKS),
    shell:
        "rover-results-csv"
        " --abc-dir {ABC_DIR} --timing-dir {TIMING_DIR}"
        " --configs {params.configs} --benchmarks {params.benchmarks}"
        " --reps {REPS} -o {output}"

rule latex_table:
    input:
        RESULTS_CSV
    output:
        TABLE_TEX
    shell:
        "rover-latex-table {input} -o {output}"

rule egraph_csv:
    input:
        expand(f"{EGRAPH_DIR}/{{bench}}.{{variant}}.size.txt",
               bench=BENCHMARKS, variant=["base-sat", "full-sat", "canon"]),
    output:
        EGRAPH_CSV
    params:
        benchmarks = " ".join(BENCHMARKS),
    shell:
        "rover-egraph-csv --egraph-dir {EGRAPH_DIR}"
        " --benchmarks {params.benchmarks} -o {output}"

rule egraph_table:
    input:
        EGRAPH_CSV
    output:
        EGRAPH_TEX
    shell:
        "rover-egraph-table {input} -o {output}"

rule provenance:
    input:
        csv = RESULTS_CSV,
        egraph_csv = EGRAPH_CSV,
    output:
        PROVENANCE,
    run:
        provenance.write(
            output[0],
            title="Tamagoyaki / Rover datapath evaluation provenance",
            repo_root=REPO_ROOT,
            fields=[
                ("rover_mlir_opt", rover_opt),
                ("rover_mlir_opt_ver",
                 provenance.cmd([rover_opt, "--version"],
                                drop=provenance.LLVM_BANNER)),
                ("circt_synth", circt_synth),
                ("circt_synth_ver",
                 provenance.cmd([circt_synth, "--version"],
                                drop=provenance.LLVM_BANNER)),
                ("circt_translate", circt_translate),
                ("abc", abc),
                # ABC echoes the -c command before answering it.
                ("abc_ver", provenance.cmd([abc, "-c", "version"], drop=1)),
                ("xdsl_opt", provenance.cmd(["xdsl-opt", "--version"])),
                ("genlib", GENLIB),
                ("genlib_sha256", provenance.sha256(GENLIB)),
                ("genlib_upstream",
                 "github.com/cowardsa/DatapathBench"
                 "@fe5941cf234bd543c45e8ccea5c10f8c95232b6f (libraries/asap7.genlib)"),
                ("build_dir", BUILD_DIR),
                ("out_dir", OUT_DIR),
                ("benchmarks", f"{len(BENCHMARKS)} ({', '.join(BENCHMARKS)})"),
                ("configurations", ", ".join(CONFIGS)),
            ],
            parameters=[
                ("max_iters", MAX_ITERS),
                ("max_nodes", MAX_NODES),
                ("timing_reps", REPS),
                ("timing_pin_cpu",
                 "<unpinned>" if PIN_CPU is None else f"cpu {PIN_CPU}"),
                ("synthesis_strategy", SYNTH_STRATEGY or "<circt-synth default>"),
                ("synth_until", SYNTH_UNTIL or "<full pipeline>"),
                ("circt_synth_flags", SYNTH_FLAGS or "<none>"),
            ],
        )

# ---------------------------------------------------------------------------
# Shared rules: PDL -> PDL-interp, the paper artifact, clean.
# ---------------------------------------------------------------------------
PAPER_FIGURES = [TABLE_TEX, EGRAPH_TEX]
PAPER_DATA = [RESULTS_CSV, EGRAPH_CSV, PROVENANCE]

include: str(REPO_ROOT / "tamagoyaki_eval" / "common.smk")
