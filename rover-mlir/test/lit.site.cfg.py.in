@LIT_SITE_CFG_IN_HEADER@

config.llvm_tools_dir = lit_config.substitute("@LLVM_TOOLS_DIR@")
config.rover_tools_dir = lit_config.substitute("@ROVER_MLIR_TOOLS_DIR@")
config.test_exec_root = lit_config.substitute("@ROVER_MLIR_TEST_EXEC_ROOT@")
config.llvm_shlib_ext = "@SHLIBEXT@"

import lit.llvm
lit.llvm.initialize(lit_config, config)

# Let the main config do the real work.
lit_config.load_config(config, "@ROVER_MLIR_TEST_LIT_CFG@")
